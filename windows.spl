index=wineventlog_security source=XmlWinEventLog:Security EventCode IN (4656,4658,4660,4663,4670,4907,4902,4719,4624,4625,4634,4647,4672,4673,4674,5140,5145,6416,6419,6420,6421,6422)
| eval m2131_code=case(
    EventCode IN (4656,4658,4660,4663,4670), "13.1",
    EventCode IN (4907,4902,4719), "13.2",
    EventCode=4624 AND Logon_Type=10, "13.5",
    EventCode IN (4624,4625,4634,4647), "13.3",
    EventCode IN (4672,4673,4674), "13.4",
    EventCode IN (5140,5145), "13.6",
    EventCode IN (6416,6419,6420,6421,6422), "13.7"
)
| stats count by m2131_code
| inputlookup append=t m2131_comp.csv  
| stats max(*) as * by m2131_code
| eval count=if(isnull(events),count,events)
| fields - events
| outputlookup m2131_comp.csv




(index=wineventlog_system EventCode IN (6005,6006,6008,6013,41,1074,7036,7034,7031,7000,7001))
OR
(index=wineventlog_security EventCode IN (4688,4689))
| eval m2131_code=case(
    EventCode IN (6005,6006,6008,6013,41,1074), "14.2",
    EventCode=7036, "14.3",
    EventCode IN (7034,7031,7000,7001), "14.4",
    EventCode IN (4688,4689), "14.5"
)
| stats count by m2131_code
| sort m2131_code
| inputlookup append=t m2131_comp.csv  
| stats max(*) as * by m2131_code
| eval count=if(isnull(events),count,events)
| fields - events
| outputlookup m2131_comp.csv


(index=wineventlog_security EventCode IN (4719,4739,4817,4902,4904,4905,4906,4907,4908,4912,1102,4720,4722,4723,4724,4725,4726,4738,4740,4767,4727,4728,4729,4730,4731,4732,4733,4734,4735,4737,4741,4742,4743,4754,4755,4756,4757,4758,4759,4698,4699,4700,4701,4702))
OR
(index=wineventlog_system EventCode=104)
| eval m2131_code=case(
    EventCode IN (4719,4739,4817,4902,4904,4905,4906,4907,4908,4912), "15.1",
    EventCode IN (1102,104), "15.2",
    EventCode IN (4720,4722,4723,4724,4725,4726,4738,4740,4767), "15.3",
    EventCode IN (4727,4728,4729,4730,4731,4732,4733,4734,4735,4737,4741,4742,4743,4754,4755,4756,4757,4758,4759), "15.4",
    EventCode IN (4698,4699,4700,4701,4702), "15.5"
)
| stats count by m2131_code
| sort m2131_code
| inputlookup append=t m2131_comp.csv  
| stats max(*) as * by m2131_code
| eval count=if(isnull(events),count,events)
| fields - events
| outputlookup m2131_comp.csv


index=wineventlog_security EventCode IN (4663,5140,5145,6416,4663,5140,5145,6416,4657,4688)
| eval m2131_code=case(
    EventCode=4657, "18.3",
    EventCode=4688, "18.4",
    EventCode IN (4663,5140,5145,6416), "16.1"
)
| stats count by m2131_code
| inputlookup append=t m2131_comp.csv  
| stats max(*) as * by m2131_code
| eval count=if(isnull(events),count,events)
| fields - events
| outputlookup m2131_comp.csv