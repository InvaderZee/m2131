index=* sourcetype=WinEventLog:Security 
EventCode IN (4656,4658,4660,4663,4670,4907,4902,4719,4624,4625,4634,4647,4672,4673,4674,5140,5145,6416,6419,6420,6421,6422)
| eval m2131_code=case(
    EventCode IN (4656,4658,4660,4663,4670), "13.1 File and Object Access",
    EventCode IN (4907,4902,4719), "13.2 Audit Log Access",
    EventCode=4624 AND Logon_Type=10, "13.5 RDP Access and Log Off",
    EventCode IN (4624,4625,4634,4647), "13.3 System Access and Log Off",
    EventCode IN (4672,4673,4674), "13.4 Privilege Access and Log Off",
    EventCode IN (5140,5145), "13.6 SMB Access",
    EventCode IN (6416,6419,6420,6421,6422), "13.7 Installation or Removal of Storage Volumes"
)
| stats count by m2131_code
| sort m2131_code