``` Identity & Credential Management / Privileged Identity & Credential Management ```
index=azure sourcetype="o365:management:activity" source="*Audit_AzureActiveDirectory*" ResultStatus=Success NOT user=zz*
| stats count by action
| eval m2131_code=case(action="created", "1.1", action="modified", mvappend("1.2", "1.3"), action="deleted", "1.5", 1=1, "1.4")
| mvexpand m2131_code
| table m2131_code, count
| append [ search index=azure sourcetype="o365:management:activity" source="*Audit_AzureActiveDirectory*" ResultStatus=Success user=zz*
| stats count by action
| eval m2131_code=case(action="created", "1.1", action="modified", mvappend("2.2", "2.3"), action="deleted", "1.5", 1=1, "2.4")
| mvexpand m2131_code
| table m2131_code, count ]
| append [ search index=azure sourcetype=mscs:insights:provisioninglogs resultType="success" properties.action IN (Create, Delete, Disable)
| stats count by properties.action
| rename properties.action as action
| eval m2131_code=case(action="Create", "2.1", 1=1, "2.5")
| table m2131_code, count ]
| append [| tstats count where index=cyberark sourcetype="cyberark:epv:cef"
| eval m2131_code=mvappend("2.7","2.8","2.9")
| mvexpand m2131_code]
| inputlookup append=t m2131_comp.csv  
| stats max(*) as * by m2131_code
| eval count=if(isnull(events),count,events)
| fields - events
| outputlookup m2131_comp.csv


index=azure sourcetype=azure:aad:audit category=UserManagement targetResources{}.displayName=zz*
| stats count 
| eval m2131_code="2.6"
| inputlookup append=t m2131_comp.csv  
| stats max(*) as * by m2131_code
| eval count=if(isnull(events),count,events)
| fields - events
| outputlookup m2131_comp.csv

index=azure sourcetype IN (mscs:insights:riskyusers, mscs:insights:userriskevents) identity=zz*
| stats count 
| eval m2131_code="2.10"
| inputlookup append=t m2131_comp.csv  
| stats max(*) as * by m2131_code
| eval count=if(isnull(events),count,events)
| fields - events
| outputlookup m2131_comp.csv



| tstats count where index=dhs_cribl sourcetype="pan:traffic" by host
| eval m2131_code="8.4"
